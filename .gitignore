# ==============================================================================
# MISC & SECURITY
# ==============================================================================
*.bak
*.tmp
*.temp
secret.key
secrets.yaml
credentials.json
token.txt

# Steam Guard maFiles (NEVER commit — contains shared_secret, identity_secret, session tokens)
*.maFile
**/*.maFile
# maFile encryption key + salt (auto-generated when HEIMDALL_SECRET_KEY is unset — NEVER commit)
.heimdall_key
.heimdall_salt
**/.heimdall_key
**/.heimdall_salt
# Mimir credential vault (encrypted login/password/email store — NEVER commit)
credentials.vault
**/credentials.vault

# Heimdall runtime data (maFiles/ folder itself may contain README + .gitkeep)
Yggdrasil/heimdall/backend/logs/
Yggdrasil/heimdall/backend/cache/

# Heimdall settings hold the Tradeon token — keep local, use settings.example.json as the template
Yggdrasil/heimdall/backend/settings.json
# CSFloat API keys (rotation pool) — secrets, keep local
Yggdrasil/heimdall/backend/csfloat_keys.json
# Telegram caller account (api_hash + login session for ring-alerts) — SECRET, keep local
Yggdrasil/heimdall/backend/telegram_caller.json
telegram_caller.session
# Draupnir portfolio data (personal holdings) is committed on purpose as a backup —
# it holds no secrets, just item names / prices / dates.
# ...but the local point-in-time snapshot history stays on-disk only (can be large).
Yggdrasil/heimdall/backend/backups/
