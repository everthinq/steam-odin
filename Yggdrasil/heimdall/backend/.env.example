# Copy to .env and adjust (never commit .env)

FLASK_ENV=development
PORT=5000
RATATOSKR_URL=http://localhost:3030

# Strongly recommended: a long random string used to encrypt stored maFile 2FA
# secrets. If left unset, the backend auto-generates a strong key in
# maFiles/.heimdall_key (gitignored) — but setting it here keeps the key out of
# the data directory. It is NEVER the old hardcoded default anymore.
# Back up this value (or maFiles/.heimdall_key) or your maFiles become unreadable.
HEIMDALL_SECRET_KEY=change-me-to-a-long-random-string

# Optional: outbound proxy (see docker-compose.yml)
# HTTP_PROXY=
# HTTPS_PROXY=
# SOCKS_PROXY=
